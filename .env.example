# GEMINI_API_KEY: Required for Gemini AI Vedic scholarship and translation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000

# ==========================================
# Sequential Atharvaveda Starting Point
# ==========================================
START_KANDA="6"
START_SUKTA="17"
START_ANUVAKA="0"
START_MANTRA="2"
AUTO_ADVANCE="true"
SCHEDULE_CRON="0 6 * * *"

# ==========================================
# Telegram Bot Dispatch (with Audio File)
# ==========================================
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_CHAT_ID="your_channel_or_personal_chat_id"

# ==========================================
# Email SMTP Dispatch (with MP3 Attachment)
# ==========================================
EMAIL_TO="shobhasrinivas@gmail.com"
EMAIL_FROM="Atharvaveda Chants <daily@atharvaveda.org>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"

# ==========================================
# WhatsApp / WhatsApp Group Settings
# ==========================================
WHATSAPP_PHONE="+919876543210"
WHATSAPP_GROUP_ID="your_whatsapp_group_id_or_invite_code"
WHATSAPP_WEBHOOK_URL=""

